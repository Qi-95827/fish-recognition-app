<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow" />
            <corners android:radius="@dimen/clay_radius_large" />
            <padding
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="6dp" />
        </shape>
    </item>

    <!-- 按钮主体 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_primary" />
            <corners android:radius="@dimen/clay_radius_large" />
        </shape>
    </item>
</layer-list>
