<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 柔和阴影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/clay_shadow" />
            <size
                android:width="72dp"
                android:height="72dp" />
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="8dp" />
        </shape>
    </item>

    <!-- 按钮主体 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/clay_secondary" />
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>
</layer-list>
